# SoundCloud User object
public type User record {
    # country
    string country?;
    # a list subscriptions associated with the user
    # 
    # # Deprecated
    @deprecated
    Subscription[] subscriptions?;
    # city
    string city?;
    # description
    string description?;
    # profile creation datetime
    @jsondata:Name {value: "created_at"}
    string createdAt?;
    # number of public tracks
    @jsondata:Name {value: "track_count"}
    int trackCount?;
    # discogs name
    @jsondata:Name {value: "discogs_name"}
    string discogsName?;
    # number of favorited public tracks
    @jsondata:Name {value: "public_favorites_count"}
    int publicFavoritesCount?;
    # number of reposts from user
    @jsondata:Name {value: "reposts_count"}
    int repostsCount?;
    # a custom title for the website
    @jsondata:Name {value: "website_title"}
    string websiteTitle?;
    # first name
    @jsondata:Name {value: "first_name"}
    string firstName?;
    # last modified datetime
    @jsondata:Name {value: "last_modified"}
    string lastModified?;
    # subscription plan of the user
    string plan?;
    # number of public playlists
    @jsondata:Name {value: "playlist_count"}
    int playlistCount?;
    # a URL to the website
    string website?;
    # kind of resource
    string kind?;
    # last name
    @jsondata:Name {value: "last_name"}
    string lastName?;
    # URN of the user's artist station system playlist, when available. Uses the `system-playlists` collection (e.g. `soundcloud:system-playlists:artist-stations:{id}`). Omitted or null when the user has no public tracks or no station
    @jsondata:Name {value: "station_urn"}
    string? stationUrn?;
    # number of followed users
    @jsondata:Name {value: "followings_count"}
    int followingsCount?;
    # API resource URL
    string uri?;
    # unique identifier
    string urn?;
    # first and last name
    @jsondata:Name {value: "full_name"}
    string fullName?;
    # URL to a JPEG image
    @jsondata:Name {value: "avatar_url"}
    string avatarUrl?;
    # number of followers
    @jsondata:Name {value: "followers_count"}
    int followersCount?;
    # permalink of the resource
    string permalink?;
    # URL to the SoundCloud.com page
    @jsondata:Name {value: "permalink_url"}
    string permalinkUrl?;
    # username
    string username?;
};

