    # Filters content by level of access the user (logged in or anonymous) has to the track. The result list will include only tracks with the specified access. Include all options if you'd like to see all possible tracks. See `Track#access` schema for more details
    ("playable"|"preview"|"blocked")[] access?;
};

# Represents the Queries record for the operation: listMyTrackReposts
public type ListMyTrackRepostsQueries record {
    # Filters content by level of access the user (logged in or anonymous) has to the track. The result list will include only tracks with the specified access. Include all options if you'd like to see all possible tracks. See `Track#access` schema for more details
    ("playable"|"preview"|"blocked")[] access?;
    # Number of results to return in the collection
    @constraint:Int {minValue: 1, maxValue: 200}
    int 'limit = 50;
    # Returns paginated collection of items (recommended, returning a list without pagination is deprecated and should not be used)
    @http:Query {name: "linked_partitioning"}
    boolean linkedPartitioning?;
};

public type WebProfile record {
    # Id
    string urn?;
    # Kind
    string kind?;
    # Service or platform
    string 'service?;
    # Timestamp of when the link was added to the profile
    @jsondata:Name {value: "created_at"}
    string createdAt?;
    # Link's title
    string title?;
    # URL of the external link
    string url?;
    # Username extracted from the external link
    string username?;
};

# Provides API key configurations needed when communicating with a remote HTTP endpoint.
public type ApiKeysConfig record {|
    # The string "OAuth" followed by the user’s token: OAuth ACCESS_TOKEN. Obtained in oAuth2.1 flow
    @display {label: "", kind: "password"}
    string authorization;
|};

