public type created_at record {
    # (yyyy-mm-dd hh:mm:ss) return tracks created at this date or later
    string 'from?;
    # (yyyy-mm-dd hh:mm:ss) return tracks created at this date or earlier
    string to?;
};

public type CreateUpdatePlaylistRequestPlaylist record {
    # Playlist's release
    string release?;
    # Purchase URL
    @jsondata:Name {value: "purchase_url"}
    string purchaseUrl?;
    # Playlist or album type
    @jsondata:Name {value: "set_type"}
    "album"|"playlist" setType?;
    # Description of the playlist
    string description?;
    # Title of the playlist
    string title?;
    # public or private
    "public"|"private" sharing?;
    # List of tracks to add to playlist
    CreateUpdatePlaylistRequestPlaylistTracks[] tracks?;
    # License number
    string license?;
    @jsondata:Name {value: "artwork_data"}
    record {byte[] fileContent; string fileName;} artworkData?;
    # Purchase title
    @jsondata:Name {value: "purchase_title"}
    string purchaseTitle?;
    # The European Article Number
    string ean?;
    # Release date
    @jsondata:Name {value: "release_date"}
    string releaseDate?;
    # A comma-separated list of tags
    @jsondata:Name {value: "tag_list"}
    string tagList?;
    # Playlist's genre
    string genre?;
    # Playlist's permalink
    string permalink?;
    # Full permalink URL
    @jsondata:Name {value: "permalink_url"}
    string permalinkUrl?;
    # Label name
    @jsondata:Name {value: "label_name"}
    string labelName?;
};

# Represents the Queries record for the operation: listUserTracks
public type ListUserTracksQueries record {
    # Filters content by level of access the user (logged in or anonymous) has to the track. The result list will include only tracks with the specified access. Include all options if you'd like to see all possible tracks. See `Track#access` schema for more details
    ("playable"|"preview"|"blocked")[] access?;
    # Number of results to return in the collection
    @constraint:Int {minValue: 1, maxValue: 200}
    int 'limit = 50;
    # Sort order of tracks by upload date. `desc` returns newest tracks first; `asc` returns oldest first. Also accepts `direction` or `order` as aliases
    "asc"|"desc" sort = "desc";
    # Returns paginated collection of items (recommended, returning a list without pagination is deprecated and should not be used)
    @http:Query {name: "linked_partitioning"}
    boolean linkedPartitioning?;
};

# Tracks returned either as a paginated collection or as a plain list, depending on the linked_partitioning query parameter
public type TracksResult Tracks|TracksList;

public type duration record {
    # Return tracks with at least this duration value
    int 'from?;
    # Return tracks with at most this duration value
    int to?;
};

