# Soundcloud Track object
public type Track record {
    # Number of comments
    @jsondata:Name {value: "comment_count"}
    int commentCount?;
    # Is downloadable
    boolean downloadable?;
    # Level of access the user (logged in or anonymous) has to the track.
    #   * `playable` - user is allowed to listen to a full track.
    #   * `preview` - user is allowed to preview a track, meaning a snippet is available
    #   * `blocked` - user can only see the metadata of a track, no streaming is possible
    "playable"|"preview"|"blocked"? access?;
    # Release
    string release?;
    # List of country codes where track is available
    @jsondata:Name {value: "available_country_codes"}
    string availableCountryCodes?;
    # Created timestamp
    @jsondata:Name {value: "created_at"}
    string createdAt?;
    # Track description
    string description?;
    # Track title
    string title?;
    # Track duration in milliseconds
    int duration?;
    # URL to a JPEG image
    @jsondata:Name {value: "artwork_url"}
    string artworkUrl?;
    # Is streamable
    boolean streamable?;
    # Tags
    @jsondata:Name {value: "tag_list"}
    string tagList?;
    # Month of release
    @jsondata:Name {value: "release_month"}
    int releaseMonth?;
    # Genre
    string genre?;
    # Day of release
    @jsondata:Name {value: "release_day"}
    int releaseDay?;
    # URL to download a track. Omitted or null when track is not downloadable
    @jsondata:Name {value: "download_url"}
    string? downloadUrl?;
    # Optional artist name, when different from user
    @jsondata:Name {value: "metadata_artist"}
    string metadataArtist?;
    # Number of reposts
    @jsondata:Name {value: "reposts_count"}
    int repostsCount?;
    # Secret URL
    @jsondata:Name {value: "secret_uri"}
    string secretUri?;
    # Label user name
    @jsondata:Name {value: "label_name"}
    string labelName?;
    # Tempo
    decimal bpm?;
    # Is commentable
    boolean commentable?;
    # Number of favoritings
    @jsondata:Name {value: "favoritings_count"}
    int favoritingsCount?;
    # Type of object (track)
    string kind?;
    # Whether play and favorite counts are visible. When false (quiet mode), stats are hidden
    @jsondata:Name {value: "reveal_stats"}
    boolean revealStats?;
    # Purchase URL
    @jsondata:Name {value: "purchase_url"}
    string purchaseUrl?;
    # Year of release
    @jsondata:Name {value: "release_year"}
    int releaseYear?;
    # Key signature
    @jsondata:Name {value: "key_signature"}
    string keySignature?;
    # ISRC code
    string isrc?;
    # URN of the track's station system playlist, when available. Uses the `system-playlists` collection (e.g. `soundcloud:system-playlists:track-stations:{id}`). Omitted or null for non-public tracks and tracks without a station
    @jsondata:Name {value: "station_urn"}
    string? stationUrn?;
    # Type of sharing (public/private)
    string sharing?;
    # Track URI
    string uri?;
    # Number of downloads
    @jsondata:Name {value: "download_count"}
    int downloadCount?;
    # Track URN identifier
    string urn?;
    # License
    string license?;
    # Purchase title
    @jsondata:Name {value: "purchase_title"}
    string purchaseTitle?;
    # Embeddable by
    # 
    # # Deprecated
    @jsondata:Name {value: "embeddable_by"}
    @deprecated
    string embeddableBy?;
    # Is user's favourite. It is only set when fetching search results or single track, otherwise it is false
    @jsondata:Name {value: "user_favorite"}
    boolean userFavorite?;
    # Whether comments are visible. When false (quiet mode), comments are hidden
    @jsondata:Name {value: "reveal_comments"}
    boolean revealComments?;
    # Waveform URL
    @jsondata:Name {value: "waveform_url"}
    string waveformUrl?;
    # Permalink URL
    @jsondata:Name {value: "permalink_url"}
    string permalinkUrl?;
    # User who uploaded a track
    User? user?;
    # Number of plays by a user
    @jsondata:Name {value: "user_playback_count"}
    int userPlaybackCount?;
    # Number of plays
    @jsondata:Name {value: "playback_count"}
    int playbackCount?;
    # URL to stream (preview only)
    # 
    # # Deprecated
    @jsondata:Name {value: "stream_url"}
    @deprecated
    string streamUrl?;
};

# Represents the Queries record for the operation: listUserPlaylists
public type ListUserPlaylistsQueries record {
    # Filters content by level of access the user (logged in or anonymous) has to the track. The result list will include only tracks with the specified access. Include all options if you'd like to see all possible tracks. See `Track#access` schema for more details
    ("playable"|"preview"|"blocked")[] access?;
